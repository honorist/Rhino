# ====== App ======
COMPOSE_PROJECT_NAME=rhino
APP_PORT=3001
NODE_ENV=production

# ====== Postgres ======
POSTGRES_USER=rhino
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=rhino
POSTGRES_PORT=5432

# DATABASE_URL é montada pelo compose; defina manualmente só se rodar fora do compose
# DATABASE_URL=postgres://rhino:troque_esta_senha@localhost:5432/rhino

# ====== Auth ======
# Cria automaticamente um usuário admin no primeiro boot SE nenhum usuário existir.
# Após o primeiro login, troque a senha ou crie outros usuários e comente estas linhas.
ADMIN_EMAIL=admin@rhino.local
ADMIN_PASSWORD=troque_esta_senha

# ====== Criptografia de PII (LGPD) ======
# Chave AES-256 (32 bytes) usada para cifrar CPF e arquivos de documentos em
# repouso. OBRIGATÓRIA assim que houver PII cifrada — perder a chave = perder o
# acesso aos dados. Guarde-a como SECRET (não no git) e faça backup SEPARADO do
# backup do banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=troque_por_uma_chave_de_32_bytes_em_base64
