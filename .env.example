# ====== App ======
COMPOSE_PROJECT_NAME=rhino
APP_PORT=3001
NODE_ENV=production

# ====== Postgres ======
POSTGRES_USER=rhino
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=rhino
POSTGRES_PORT=5432

# DATABASE_URL é montada pelo compose; defina manualmente só se rodar fora do compose
# DATABASE_URL=postgres://rhino:troque_esta_senha@localhost:5432/rhino

# ====== Auth ======
# Cria automaticamente um usuário admin no primeiro boot SE nenhum usuário existir.
# Após o primeiro login, troque a senha ou crie outros usuários e comente estas linhas.
ADMIN_EMAIL=admin@rhino.local
ADMIN_PASSWORD=troque_esta_senha

# ====== Criptografia de PII (LGPD) ======
# Chave AES-256 (32 bytes) usada para cifrar CPF e arquivos de documentos em
# repouso. OBRIGATÓRIA assim que houver PII cifrada — perder a chave = perder o
# acesso aos dados. Guarde-a como SECRET (não no git) e faça backup SEPARADO do
# backup do banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=troque_por_uma_chave_de_32_bytes_em_base64

# ====== Observabilidade (lib/observability.js) ======
# Para onde vão os erros capturados (uncaughtException, unhandledRejection e 5xx).
#   console  -> linha JSON no stdout (DEFAULT; já é o que Railway/Docker coletam)
#   webhook  -> POST em OBSERVABILITY_WEBHOOK_URL (Slack, Discord, Better Stack...)
#   noop     -> silêncio (default sob NODE_ENV=test)
# Sem SDK de terceiro: o webhook entrega o essencial sem cadeia de suprimentos.
OBSERVABILITY_SINK=console
# Obrigatória quando OBSERVABILITY_SINK=webhook. É SECRET — não versione.
# OBSERVABILITY_WEBHOOK_URL=
# Anti-enxurrada: no máximo MAX_PER_KEY eventos do mesmo erro por janela.
# Um erro em laço não pode virar 10.000 alertas (nem 10.000 requests ao coletor).
# OBSERVABILITY_WINDOW_MS=60000
# OBSERVABILITY_MAX_PER_KEY=5
