{
  "name": "rhino",
  "version": "1.0.41",
  "description": "Business management app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "playwright test test/e2e/api.spec.js",
    "test:headers": "node --test test/headers.test.js",
    "test:validate": "node --test test/validate.test.js",
    "test:healthz": "node --test test/healthz.test.js",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --migration-file-language sql",
    "db:migrate:down": "node-pg-migrate down --migrations-dir db/migrations --migration-file-language sql",
    "db:migrate:status": "node-pg-migrate status --migrations-dir db/migrations --migration-file-language sql",
    "db:migrate:fake": "node-pg-migrate up --fake --migrations-dir db/migrations --migration-file-language sql",
    "db:migrate-json": "node scripts/migrate-json-to-pg.js",
    "backup:prod": "node scripts/backup-prod.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "docx": "^9.6.1",
    "jimp": "^1.6.1",
    "pdf-to-img": "^6.0.0",
    "pg": "^8.20.0",
    "puppeteer": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "node-pg-migrate": "^8.0.4"
  }
}
